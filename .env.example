# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo a .env y asigna tus claves privadas reales.
# NUNCA compartas ni subas tu archivo .env a Git.
# ==============================================================================

# Clave privada EVM (Ethereum, BSC, Polygon, Arbitrum, Base, etc.)
# Formato: 32 bytes en hex (64 caracteres con o sin prefijo 0x)
EVM_PRIVATE_KEY=0xTU_CLAVE_PRIVADA_AQUI

# Clave privada Solana (Formato Base58 habitual de Phantom o Solflare)
SOLANA_PRIVATE_KEY=TU_CLAVE_PRIVADA_EN_BASE58

# Claves opcionales por cadena
BTC_PRIVATE_KEY=
APTOS_PRIVATE_KEY=
SUI_PRIVATE_KEY=

# Lista separada por comas si manejas varias claves del mismo tipo
EVM_PRIVATE_KEYS_LIST=0xCLAVE1,0xCLAVE2
